        .movie-card:hover {
          transform: translateY(-5px);
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }
        .movie-poster {
          height: 400px;
          object-fit: cover;
          transition: transform 0.5s ease;
        }
        .movie-card:hover .movie-poster {
          transform: scale(1.05);
        }
      `}</style>
